---
import '../styles/global.css';
import { Font } from 'astro:assets';
interface Props {
titulo: string;
}
const { titulo } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{titulo}</title>
<Font cssVariable="--font-special" preload />
</head>
<body class="flex">
<slot name="header" />
<slot name="main" />
<slot/>
<slot name="footer" />
</body>
</html>