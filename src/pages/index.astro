---
import LayoutSecundario from '../layouts/LayoutSecundario.astro';
import Contenido from '../components/contenido.astro';

const cantidad = Number(Astro.url.searchParams.get('cantidad')) || 1;
---

<LayoutSecundario titulo="Inicio" classname="bg-emerald-200">
  <main class="flex flex-1">
    <Contenido server:defer cantidad={cantidad}>
      <div class="bg-emerald-200 w-screen h-48" slot="fallback"></div>
    </Contenido>
  </main>
</LayoutSecundario>